rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────
    function isSuperAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    function isMember(centerId) {
      return request.auth != null
          && exists(/databases/$(database)/documents/servicecenters/$(centerId)/staff/$(request.auth.uid));
    }

    function memberData(centerId) {
      return get(/databases/$(database)/documents/servicecenters/$(centerId)/staff/$(request.auth.uid)).data;
    }

    function hasRole(centerId, roles) {
      return isMember(centerId) && memberData(centerId).role in roles;
    }

    // ── Super Admins ────────────────────────────────────────────────────────────
    match /superadmins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // managed only via Firebase Console / Admin SDK
    }

    // ── User index ────────────────────────────────────────────────────────────
    // Lightweight mapping uid → { centerId, role } so the client can resolve
    // identity on login.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // ── Short links ─────────────────────────────────────────────────────────────
    // Maps a short code → { centerId, customerId } so SMS links can be tiny.
    // Public read (same visibility as the customer view it resolves to); any
    // signed-in staff member may mint a code, but codes are immutable once set.
    match /links/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Service Centers ────────────────────────────────────────────────────────
    match /servicecenters/{centerId} {
      // Single-doc reads stay public: the customer share link needs the
      // center's name/address/phone without login. Listing is restricted —
      // an open list would let anyone dump every center's owner phone,
      // billing state and payment code.
      allow get: if true;
      allow list: if isSuperAdmin()
          || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if (request.auth != null && request.auth.uid == centerId) || isSuperAdmin();
      // Owner/Manager may edit operational fields, but billing/ownership
      // fields (multi-branch plan, subscription state, SMS quota) are
      // super-admin-only.
      allow update: if isSuperAdmin()
          || (hasRole(centerId, ['Owner', 'Manager'])
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                   'ownerUid', 'isBranch', 'primaryCenterId', 'monthlyRate', 'isActive',
                   'plan', 'status', 'currentPeriodStart', 'currentPeriodEnd',
                   'graceDeadline', 'smsQuotaLimit', 'paymentCode',
                 ]));
      allow delete: if false;

      // Settings sub-collection — rolePermissions document is read by all
      // staff, written only by the Owner. The Owner check must go through the
      // staff record, not `uid == centerId`: that only holds for a primary
      // center, so on any additional branch (its own generated id) the owner
      // could never save role permissions.
      match /settings/{settingId} {
        allow read: if isSuperAdmin() || isMember(centerId) || request.auth.uid == centerId;
        allow write: if hasRole(centerId, ['Owner']) || request.auth.uid == centerId;
      }

      // Custom roles — owner-defined named roles with their own feature
      // grid. Read by all staff (a member needs to resolve their own
      // assigned custom role's permissions); only the Owner may define them.
      // `baseRole` on the document only affects which of the fixed
      // Owner/Manager/Technician/Cashier/Receptionist strings a staff member
      // assigned this custom role is stored under, so their Firestore data
      // access is unaffected by this collection.
      match /customRoles/{roleId} {
        allow read: if isSuperAdmin() || isMember(centerId) || request.auth.uid == centerId;
        allow write: if hasRole(centerId, ['Owner']) || request.auth.uid == centerId;
      }

      // Payments sub-collection — super admin full access; center owner can read own records
      match /payments/{paymentId} {
        allow read: if isSuperAdmin() || request.auth.uid == centerId;
        allow create: if isSuperAdmin();
        allow update, delete: if false;
      }

      // Customers sub-collection
      match /customers/{customerId} {
        // Public get of a single doc so the share link /c/:centerId/:customerId
        // works without login. Listing/searching the customer directory is
        // staff-only — otherwise anyone could dump every customer's name and
        // phone number.
        allow get: if true;
        allow list: if isSuperAdmin() || isMember(centerId);
        allow create: if hasRole(centerId, ['Owner', 'Manager', 'Receptionist']);
        allow update: if hasRole(centerId, ['Owner', 'Manager', 'Receptionist']);
        allow delete: if false;
      }

      // Vehicles sub-collection
      match /vehicles/{vehicleId} {
        // Public read so the share link surfaces the customer's vehicles.
        allow read: if true;
        // Technician and Cashier = View only; only Owner/Manager/Receptionist can write
        allow create: if hasRole(centerId, ['Owner', 'Manager', 'Receptionist']);
        allow update: if hasRole(centerId, ['Owner', 'Manager', 'Receptionist']);
        allow delete: if false;

        // Activity log — append-only. Any signed-in staff member can record
        // an entry (system events fire from actions already gated by the
        // rule above; staff notes are gated by the app's vehicles.edit
        // permission, a UI-layer check). Entries are never edited or removed
        // once written, preserving the audit trail.
        match /logs/{logId} {
          allow read: if isSuperAdmin() || isMember(centerId);
          allow create: if isMember(centerId);
          allow update, delete: if false;
        }
      }

      // Services sub-collection (legacy)
      match /services/{serviceId} {
        allow read: if isSuperAdmin() || isMember(centerId);
        allow create: if hasRole(centerId, ['Owner', 'Manager', 'Receptionist', 'Technician']);
        // Cashier = View only on service jobs
        allow update: if hasRole(centerId, ['Owner', 'Manager', 'Receptionist', 'Technician']);
        allow delete: if false;
      }

      // Jobs sub-collection — public read for the share link's service history.
      match /jobs/{jobId} {
        allow read: if true;
        allow create: if hasRole(centerId, ['Owner', 'Manager', 'Receptionist', 'Technician']);
        // Cashier = View only on service jobs
        allow update: if hasRole(centerId, ['Owner', 'Manager', 'Receptionist', 'Technician']);
        allow delete: if false;

        // Vehicle inspection nested under each job
        match /inspection/{docId} {
          allow read: if true;
          allow create: if hasRole(centerId, ['Owner', 'Manager', 'Receptionist', 'Technician']);
          allow update: if hasRole(centerId, ['Owner', 'Manager', 'Receptionist', 'Technician']);
          allow delete: if false;
        }
      }

      // Service price catalog — staff read/write only.
      match /servicePrices/{itemId} {
        allow read: if isSuperAdmin() || isMember(centerId);
        allow write: if hasRole(centerId, ['Owner', 'Manager']);
      }

      // SMS logs sub-collection
      match /smsLogs/{logId} {
        allow read: if isSuperAdmin() || isMember(centerId);
        // Cashier = None, Receptionist = None for SMS sending.
        // Super admin can also create (subscription/payment SMS to the center owner).
        allow create: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager', 'Technician']);
        allow update: if false;
        allow delete: if false;
      }

      // Push notification tokens — one doc per device, doc id is the FCM token
      // itself so re-registering the same device just overwrites its own doc.
      // Never read back client-side: the reminder Cloud Function reads them
      // with the Admin SDK, which bypasses these rules entirely.
      match /pushTokens/{tokenId} {
        allow read: if false;
        allow create, update: if hasRole(centerId, ['Owner']) && request.resource.data.uid == request.auth.uid;
        allow delete: if hasRole(centerId, ['Owner']);
      }

      // Inventory sub-collection
      match /inventory/{itemId} {
        // Receptionist = None; Technician and Cashier = View only
        // (a technician needs to see stock to request parts for a job).
        allow read: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager', 'Cashier', 'Technician']);
        allow create: if hasRole(centerId, ['Owner', 'Manager']);
        // Owner/Manager manage the item itself. A technician may only move
        // stock — completing a job deducts the parts it used; anything else
        // (price, threshold, supplier) stays with Owner/Manager, and asking
        // for stock goes through inventoryRequests below.
        allow update: if hasRole(centerId, ['Owner', 'Manager'])
                      || (hasRole(centerId, ['Technician'])
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['currentQty', 'deductionLog', 'updatedAt']));
        allow delete: if hasRole(centerId, ['Owner', 'Manager']);
      }

      // Inventory requests — a technician asking for parts. Any staff member
      // may read the queue (the page itself narrows it to the requester's own
      // rows), technicians and managers create them, and only Owner/Manager
      // approve or reject.
      match /inventoryRequests/{requestId} {
        allow read: if isSuperAdmin() || isMember(centerId);
        allow create: if hasRole(centerId, ['Owner', 'Manager', 'Technician'])
                      && request.resource.data.requestedBy == request.auth.uid
                      && request.resource.data.status == 'pending';
        allow update: if hasRole(centerId, ['Owner', 'Manager']);
        allow delete: if false;
      }

      // Outlets — retail counters the center sells stock from directly to
      // walk-in buyers, separate from the workshop's customers/vehicles.
      // Owner/Manager manage them; a cashier reads the list to pick which
      // counter they're selling from.
      match /outlets/{outletId} {
        allow read: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager', 'Cashier']);
        allow create, update: if hasRole(centerId, ['Owner', 'Manager']);
        allow delete: if hasRole(centerId, ['Owner', 'Manager']);
      }

      // Outlet POS sales. Written once by whoever rang it up — the deduction
      // it describes has already happened by the time this commits, so the
      // record can never be more than what actually left the shelf. Only
      // Owner/Manager may void one afterwards, and only the void fields.
      match /posSales/{saleId} {
        allow read: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager', 'Cashier']);
        allow create: if hasRole(centerId, ['Owner', 'Manager', 'Cashier'])
                      && request.resource.data.soldBy == request.auth.uid
                      && request.resource.data.status == 'completed';
        allow update: if hasRole(centerId, ['Owner', 'Manager'])
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'voidedAt', 'voidedBy', 'voidedByName', 'voidReason']);
        allow delete: if false;
      }

      // Inventory movement ledger — one row per stock-changing event, from
      // every source (restock, issue, job deduction, distributor release,
      // outlet sale, stock-count adjustment). Written by whoever performed
      // the action that's already committed; never edited or removed.
      match /inventoryMovements/{movementId} {
        allow read: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager', 'Cashier', 'Technician']);
        allow create: if hasRole(centerId, ['Owner', 'Manager', 'Cashier', 'Technician'])
                      && request.resource.data.performedBy == request.auth.uid;
        allow update, delete: if false;
      }

      // Physical stock counts — Owner/Manager only. A draft can be edited
      // (lines still being entered/adjusted); once finalized nothing about it
      // may change, since it has already written its adjustments to
      // inventory and the movement ledger.
      match /stockCounts/{countId} {
        allow read: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager']);
        allow create: if hasRole(centerId, ['Owner', 'Manager']);
        allow update: if hasRole(centerId, ['Owner', 'Manager']) && resource.data.status != 'finalized';
        allow delete: if false;
      }

      // Suppliers — who the center buys stock from. A cashier may read them
      // (an item carries its supplier, and they answer the phone), but the
      // buying relationship itself is Owner/Manager territory.
      match /suppliers/{supplierId} {
        allow read: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager', 'Cashier']);
        allow create, update: if hasRole(centerId, ['Owner', 'Manager']);
        allow delete: if hasRole(centerId, ['Owner', 'Manager']);
      }

      // Goods-received records. Each one says what arrived, from whom, and at
      // what cost — an audit trail behind the stock and price changes it made,
      // so what was delivered is written once and never edited or removed.
      // How it was *paid for* keeps moving after the fact (a cheque is written,
      // presented, sometimes returned; a credit is settled weeks later), so
      // Owner/Manager may update the payment ledger and its derived totals —
      // and nothing else.
      match /supplierSupplies/{supplyId} {
        allow read: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager']);
        allow create: if hasRole(centerId, ['Owner', 'Manager']);
        allow update: if hasRole(centerId, ['Owner', 'Manager'])
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['payments', 'paidTotal', 'creditTotal',
                                     'balanceDue', 'paymentStatus', 'updatedAt']);
        allow delete: if false;
      }

      // "Stock more of this, please" — raised from a distributor portal through
      // the requestDistributorStock callable (Admin SDK, so these rules don't
      // apply to that write). Nothing here moves stock or money, so a cashier
      // may read the queue; only Owner/Manager answer one.
      match /distributorStockRequests/{requestId} {
        allow read: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager', 'Cashier']);
        allow create: if hasRole(centerId, ['Owner', 'Manager']);
        allow update: if hasRole(centerId, ['Owner', 'Manager'])
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'reviewNote', 'reviewedAt',
                                     'reviewedBy', 'reviewedByName']);
        allow delete: if false;
      }

      // Distributors — businesses that take stock off the center's hands.
      // They have no login: the portal reaches their catalog through callable
      // Cloud Functions (Admin SDK), which is why nothing here is public. Both
      // the token that authorises the portal and the distributor's contact
      // details stay staff-only.
      match /distributors/{distributorId} {
        allow read: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager', 'Cashier']);
        allow create, update: if hasRole(centerId, ['Owner', 'Manager']);
        allow delete: if hasRole(centerId, ['Owner', 'Manager']);
      }

      // Distributor purchase orders. Created by the distributor through the
      // submitDistributorOrder callable (Admin SDK, so these rules don't apply
      // to it) or by staff releasing stock directly. Only Owner/Manager may
      // finalize one, since finalizing moves stock out of the store room.
      match /distributorOrders/{orderId} {
        allow read: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager', 'Cashier']);
        allow create: if hasRole(centerId, ['Owner', 'Manager']);
        // A cashier takes the money at the counter, so they may record how an
        // order was settled — but only the payment fields. Quantities, status
        // and everything that moves stock stay with Owner/Manager.
        allow update: if hasRole(centerId, ['Owner', 'Manager'])
                      || (hasRole(centerId, ['Cashier'])
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['payments', 'receivedTotal', 'creditTotal',
                                         'balanceDue', 'paymentStatus', 'updatedAt']));
        allow delete: if false;
      }

      // Invoices sub-collection
      match /invoices/{invoiceId} {
        // Public read so the share link can surface invoice totals/status.
        allow read: if true;
        // Technician = None for invoices
        allow create: if hasRole(centerId, ['Owner', 'Manager', 'Cashier']);
        allow update: if hasRole(centerId, ['Owner', 'Manager', 'Cashier']);
        allow delete: if false;
      }

      // Quotations sub-collection — pre-work estimates, not yet a bill, so no
      // public read (unlike invoices, which need it for the customer share link).
      match /quotations/{quotationId} {
        allow read: if isSuperAdmin() || isMember(centerId);
        allow create: if hasRole(centerId, ['Owner', 'Manager', 'Cashier']);
        allow update: if hasRole(centerId, ['Owner', 'Manager', 'Cashier']);
        allow delete: if false;
      }

      // Invoice sequence counters
      match /counters/{counterId} {
        allow read: if isSuperAdmin() || isMember(centerId);
        // Only roles that can create invoices need counter write access
        allow write: if hasRole(centerId, ['Owner', 'Manager', 'Cashier']);
      }

      // Expenses sub-collection
      match /expenses/{expenseId} {
        allow read: if isSuperAdmin() || hasRole(centerId, ['Owner', 'Manager']);
        allow create: if hasRole(centerId, ['Owner', 'Manager']);
        allow update: if hasRole(centerId, ['Owner', 'Manager']);
        allow delete: if hasRole(centerId, ['Owner', 'Manager']);
      }

      // Staff sub-collection
      match /staff/{staffId} {
        // A user can always read their own staff doc (needed for bootstrap).
        allow read: if isSuperAdmin() || isMember(centerId) || request.auth.uid == staffId;
        // isSuperAdmin() covers branch provisioning: writing the owner's
        // Owner-role staff doc into a newly-created branch.
        allow create: if isSuperAdmin()
                       || (request.auth.uid == staffId)
                       || hasRole(centerId, ['Owner', 'Manager']);
        // Owner/Manager can update; staff can update their own non-role fields.
        allow update: if isSuperAdmin()
            || hasRole(centerId, ['Owner', 'Manager'])
            || (request.auth.uid == staffId
                && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                && !('active' in request.resource.data.diff(resource.data).affectedKeys()));
        allow delete: if false;

        // Attendance records nested under each staff member.
        match /attendance/{period} {
          allow read: if isSuperAdmin() || isMember(centerId) || request.auth.uid == staffId;
          allow write: if hasRole(centerId, ['Owner', 'Manager'])
                       || request.auth.uid == staffId;
        }
      }
    }

    // ── collectionGroup: payments — required for cross-center revenue queries ──
    // Firestore collectionGroup queries need a recursive-wildcard rule at the
    // top level in addition to the nested subcollection rule above.
    match /{path=**}/payments/{paymentId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── Upgrade Requests ───────────────────────────────────────────────────────
    // Note: centerId here may be a primary branch (centerId == owner uid) or an
    // additional branch (its own generated id) — use hasRole (which checks the
    // per-branch staff subcollection) rather than a direct uid comparison so
    // this works for both.
    match /upgradeRequests/{requestId} {
      allow read: if isSuperAdmin()
                 || hasRole(resource.data.centerId, ['Owner', 'Manager']);
      allow create: if hasRole(request.resource.data.centerId, ['Owner', 'Manager']);
      // Only super admin can update (approve/reject)
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── Payment Slip Requests ──────────────────────────────────────────────────────
    match /paymentSlipRequests/{requestId} {
      allow read: if isSuperAdmin()
                 || hasRole(resource.data.centerId, ['Owner', 'Manager']);
      allow create: if hasRole(request.resource.data.centerId, ['Owner', 'Manager']);
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── Account Deletion Requests ────────────────────────────────────────────────
    // An Owner requests permanent deletion of their whole account; a super admin
    // must approve it (the approval runs the deleteServiceCenter callable, which
    // uses the Admin SDK and bypasses these rules). Owners may read their own
    // request and create one; only super admins can update (approve/reject).
    // Nobody can delete the audit record.
    match /accountDeletionRequests/{requestId} {
      allow read: if isSuperAdmin()
                 || hasRole(resource.data.centerId, ['Owner']);
      allow create: if hasRole(request.resource.data.centerId, ['Owner']);
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── Pending Invites ────────────────────────────────────────────────────────
    match /invites/{inviteId} {
      // Anyone with the document ID can read (needed for invite acceptance
      // without auth) — but listing is staff-only, otherwise anyone could
      // harvest every pending invite token and join arbitrary centers.
      allow get: if true;
      allow list: if isSuperAdmin()
          || hasRole(resource.data.centerId, ['Owner', 'Manager']);
      // Only Owner/Manager of the target center can create invites
      allow create: if request.auth != null
          && hasRole(request.resource.data.centerId, ['Owner', 'Manager']);
      // Deletion by the invitee (their staff doc is created before the invite
      // is consumed, so they are a member by then) or by staff revoking it.
      allow delete: if isSuperAdmin() || isMember(resource.data.centerId);
      allow update: if false;
    }
  }
}
