rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Staff membership is checked via the center's Firestore staff subcollection.
    function isMember(centerId) {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/servicecenters/$(centerId)/staff/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/superadmins/$(request.auth.uid));
    }

    // Payment slips — written by service center staff, read by super admins.
    // Membership is checked against the center's staff subcollection so that
    // branch owners (whose centerId is not their auth uid) and Managers can
    // upload slips, matching the Firestore rule on paymentSlipRequests.
    // The {path=**} wildcard covers nested folders (e.g. the /monthly/ subpath
    // used for recurring subscription slips), which a single segment would miss.
    match /paymentSlips/{centerId}/{path=**} {
      allow read: if isMember(centerId) || isSuperAdmin();
      allow create: if isMember(centerId)
                    && request.resource.size < 10 * 1024 * 1024   // 10 MB max
                    && request.resource.contentType.matches('image/.*|application/pdf');
      allow update, delete: if false;
    }

    // Vehicle inspection damage photos, uploaded by staff during a job.
    // Displayed via tokened download URLs; direct reads are staff-only.
    match /inspections/{centerId}/{jobId}/{fileName} {
      allow read: if isSuperAdmin() || isMember(centerId);
      allow create: if isMember(centerId)
                    && request.resource.size < 10 * 1024 * 1024   // 10 MB max
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Vehicle QR codes & photos, nested under each vehicle. The generated QR
    // image and the staff-uploaded vehicle photos both live here. Reads are
    // public — QR codes are surfaced on the public customer share view and the
    // images are non-sensitive branding-style content — while writes/deletes
    // stay staff-only. The {path=**} wildcard covers the /photos/ subfolder and
    // the qr.png file in a single rule.
    match /servicecenters/{centerId}/vehicles/{vehicleId}/{path=**} {
      allow read: if true;
      allow write: if isMember(centerId)
                   && request.resource.size < 5 * 1024 * 1024    // 5 MB max
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isMember(centerId);
    }

    // Diagnostic scan report attachments (PDF exports / scanner-screen
    // photos, see src/lib/diagnosticReports.ts). Staff-only reads here —
    // the public /r/:shareToken page never touches Storage directly, it is
    // served the file through the "download URL" (with its own embedded
    // access token) that generateReportThumbnail and the client's own
    // getDownloadURL() call mint, which is the "signed URL" the module spec
    // calls for: the token itself is the credential, independent of these
    // rules, so a customer can open the link without being a member here.
    match /diagnosticReports/{centerId}/{vehicleId}/{fileName} {
      allow read: if isSuperAdmin() || isMember(centerId);
      allow create: if isMember(centerId)
                    && request.resource.size < 10 * 1024 * 1024   // 10 MB max
                    && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
      // The thumbnail is the one exception: generateReportThumbnail writes it
      // with the Admin SDK, which bypasses these rules entirely, so no client
      // rule needs to allow it.
      allow update: if false;
      allow delete: if isMember(centerId);
    }

    // Center logo — shown on invoices. Uploaded from Settings by staff.
    match /servicecenters/{centerId}/{fileName} {
      allow read: if true; // logo is public branding
      allow write: if isMember(centerId)
                   && request.resource.size < 2 * 1024 * 1024    // 2 MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Everything else stays denied by default.
  }
}
