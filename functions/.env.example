# Dialog eSMS configuration for PitStop IQ
# Copy to functions/.env and fill in real values. functions/.env is gitignored.
#
# The POST API flow (section 3.1 of eSMS API docs):
#   1. POST https://esms.dialog.lk/api/v2/user/login  → Bearer token (12 h)
#   2. POST https://e-sms.dialog.lk/api/v2/sms        → send SMS
#
# Register at https://esms.dialog.lk to obtain credentials.

# eSMS account username (typically your mobile number, e.g. 947XXXXXXXX)
ESMS_USERNAME=

# eSMS account password
ESMS_PASSWORD=

# Sender mask shown to recipients (max 11 characters). OPTIONAL.
# Must match a mask registered and active in your eSMS account (errCode 108
# means the mask is not registered). Leave empty to use the eSMS account's
# default registered mask. Individual service centres can override this via
# their smsSenderName field in Firestore.
ESMS_MASK=PitStopIQ

# Asia login relay. OPTIONAL — leave both empty to log in directly.
# Dialog's gateway sometimes blocks Cloud Functions IPs in us-central1 with a
# bare 403. The esmsLoginProxy function runs in asia-south1 and forwards only
# the login call. When both values are set, login tries the relay first and
# falls back to the direct hosts.
#
# Shared secret the relay requires in the x-proxy-key header. Use a long random
# string, e.g. `openssl rand -hex 32`.
ESMS_PROXY_KEY=
# Relay URL. Verify the final URL from the `firebase deploy` output.
#ESMS_PROXY_URL=https://asia-south1-pitstopiq.cloudfunctions.net/esmsLoginProxy
